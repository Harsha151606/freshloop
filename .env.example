# ─────────────────────────────────────────────────────────────
# FreshLoop AI — Environment Configuration Example
# Copy to .env.local for local development. Never commit secrets.
# ─────────────────────────────────────────────────────────────

# Supabase Auth, PostgreSQL & Storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: Legacy Anon Key fallback
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_legacy_anon_key

# Gemini AI API Key (Server-Side Only)
GEMINI_API_KEY=your_gcp_api_key.

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
